{
  "name": "dsh-theme-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three neon palettes for DeepSeek Harness, as one row in General settings.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "themes",
    "cordis.patch.yml"
  ],
  "scripts": {
